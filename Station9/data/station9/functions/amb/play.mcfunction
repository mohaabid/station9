scoreboard players set #amb s9 999999
execute if score #area s9 matches 1 run scoreboard players set #amb s9 1130
execute if score #area s9 matches 1 as @a at @s run playsound station9:amb.wind ambient @s ~ ~ ~ 0.55 1
execute if score #area s9 matches 2 run scoreboard players set #amb s9 1130
execute if score #area s9 matches 2 as @a at @s run playsound station9:amb.b8 ambient @s ~ ~ ~ 0.5 1
execute if score #area s9 matches 3 run scoreboard players set #amb s9 1130
execute if score #area s9 matches 3 as @a at @s run playsound station9:amb.b9 ambient @s ~ ~ ~ 0.6 1
